###############################################################################
# .gitignore for gh-advsec-devsecops
#
# Covers: .NET/C#, Terraform, Docker, Go, Python, JavaScript/Node.js,
#         Kubernetes (Helm), Azure, security scanning outputs, and IDEs.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# OS-generated files
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────────────────────────────────────
# Copilot / HVE-Core local state
# ─────────────────────────────────────────────────────────────────────────────
.copilot-tracking/

# ─────────────────────────────────────────────────────────────────────────────
# .NET / C# / ASP.NET Core
# ─────────────────────────────────────────────────────────────────────────────

# Build output
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*

# .NET Core lock files
project.lock.json
project.fragment.lock.json

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# MSBuild
*.binlog
!Directory.Build.rsp

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Code coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
*.dotCover
OpenCover/

# Publish output
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# Compiled object files
*_i.c
*_p.c
*_h.h
*.ilk
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# User secrets (never commit the ID mapping, the secrets themselves live outside the repo)
# The UserSecretsId in .csproj is fine; actual secrets are in %APPDATA%/Microsoft/UserSecrets

# SQL Server local files
*.mdf
*.ldf
*.ndf

# ─────────────────────────────────────────────────────────────────────────────
# Terraform
# ─────────────────────────────────────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ─────────────────────────────────────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────────────────────────────────────
**/docker-compose.override.yml

# ─────────────────────────────────────────────────────────────────────────────
# Go
# ─────────────────────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
vendor/

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.eggs/
*.egg
.venv/
venv/
ENV/
.python-version

# ─────────────────────────────────────────────────────────────────────────────
# Node.js / JavaScript
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.pnp.*

# ─────────────────────────────────────────────────────────────────────────────
# Kubernetes / Helm
# ─────────────────────────────────────────────────────────────────────────────
charts/*.tgz
**/charts/tmpcharts/

# ─────────────────────────────────────────────────────────────────────────────
# Azure
# ─────────────────────────────────────────────────────────────────────────────
csx/
*.build.csdef
ecf/
rcf/
ASALocalRun/

# ─────────────────────────────────────────────────────────────────────────────
# Security scanning tool outputs (generated, not source-controlled)
# ─────────────────────────────────────────────────────────────────────────────
results-dir/
*.sarif
!manifests/sarif.tpl
security-reports/

# ─────────────────────────────────────────────────────────────────────────────
# Environment and secrets (never commit credentials)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

